{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {},
    "e2e": {
      "extends": "preview",
      "env": {
        "ACCESSID_E2E": "1",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SUPABASE_URL": "http://127.0.0.1:1",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "accessid-test-only"
      }
    }
  }
}
